rules_version = '2';

// Deny-all for clients. The web app no longer reads or writes Firestore (waitlist/airdrop pages
// were removed) and Cloud Functions use the Admin SDK, which bypasses these rules.
// The previous rules allowed anyone to read the whole waitlist (emails) and to create documents
// in `mail`, which triggers outgoing email: an open relay. Do not re-open without validation,
// rate limits and App Check.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
