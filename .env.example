# Copy this file to .env and fill in your values
# NEVER commit .env to git — verify .gitignore includes .env

# ── RPC endpoints ──────────────────────────────────────────────────────────────
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ARB_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY

# ── Deployer wallet ────────────────────────────────────────────────────────────
# Must hold ETH for gas. Use a dedicated deployer wallet, NOT your main wallet.
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ── Allocation wallets (set before mainnet deploy) ─────────────────────────────
# Use separate wallets / multi-sigs for each allocation.
WALLET_SEED=           # Seed investors multi-sig (tokens go to vesting)
WALLET_IDO=            # Your staging wallet → you transfer to PinkSale contract
WALLET_LIQUIDITY=      # Liquidity rewards distributor
WALLET_TEAM=           # Team/advisors multi-sig (tokens go to vesting)
WALLET_TREASURY=       # Treasury multi-sig (e.g. Safe/Gnosis)
WALLET_AIRDROPS=       # Airdrop Merkle-claim or distributor contract

# ── TGE timestamp ─────────────────────────────────────────────────────────────
# June 15 2026 00:00:00 UTC
TGE_TIMESTAMP=1750032000

# ── Block explorer verification ────────────────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
ARBISCAN_API_KEY=YOUR_ARBISCAN_KEY

# ── Misc ──────────────────────────────────────────────────────────────────────
REPORT_GAS=false
