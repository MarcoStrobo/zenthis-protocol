# ═══════════════════════════════════════════════════════════════
# Zenthis Protocol — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── RPC URLs ──────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Deployer ──────────────────────────────────────────────────
# Private key of the deployer wallet (funded with testnet ETH)
DEPLOYER_PRIVATE_KEY=0x_your_private_key_here

# ── Etherscan ─────────────────────────────────────────────────
# Single v2 API key covers all EVM networks
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ── Gas Reporting ─────────────────────────────────────────────
REPORT_GAS=false

# ── Vesting Wallets (7 schedules) ─────────────────────────────
# For testnet: use the deployer address or generate fresh wallets
WALLET_SEED=0x...
WALLET_IDO=0x...
WALLET_LIQUIDITY=0x...
WALLET_TEAM=0x...
WALLET_TREASURY=0x...
WALLET_FOUNDER_OPS=0x...
WALLET_AIRDROPS=0x...

# ── Token Generation Event ────────────────────────────────────
# Unix timestamp (seconds). Must be > current block.timestamp.
# Example for 2026-06-01 00:00 UTC: 1748736000
TGE_TIMESTAMP=1748736000

# ── Deployed Addresses (auto-filled by deploy script) ─────────
# Leave blank — the deploy script writes these after deployment
TOKEN_ADDRESS=
HTLC_ADDRESS=
VESTING_ADDRESS=
