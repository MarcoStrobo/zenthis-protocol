# ── Network RPC ──────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# ── Deployer wallet (NEVER commit the real key) ───────────────────────────────
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── TGE Unix timestamp (future date) ─────────────────────────────────────────
# Example: 1750032000  →  Jun 16 2025 00:00:00 UTC
TGE_TIMESTAMP=1786147200

# ── Multi-sig (Gnosis Safe 2/2) — Ownership transferred here after deploy ────
MULTISIG_ADDRESS=0xf9C31EBAEFED9b3103bB3A19f20172A55fdEB01A

# ── Vesting beneficiary wallets ───────────────────────────────────────────────
# IMPORTANT: WALLET_TREASURY and WALLET_TEAM MUST be Gnosis Safe multi-sig (3-of-5)
# Lock WALLET_LIQUIDITY LP tokens on Team.Finance immediately after deploy

WALLET_SEED=0x17eCC2493f15c7b8265889aC3f44D4b5aE1D0665
WALLET_IDO=0xIDO_PRESALE_CONTRACT_OR_MULTISIG
WALLET_LIQUIDITY=0xaa6D1BEc62a324bAa8E1cC284e85D70484F3EBaC
WALLET_TEAM=0xebCc4B9b3417a5a818590fc0cb2A99478C2E8C79             # 12mo cliff + 36mo vest — no early exit
WALLET_TREASURY=0xe1985d3f16714d202579CF758C9cFd3386bb6FA9         # Gnosis Safe required (3/5 multisig)
WALLET_FOUNDER_OPS=0x47B4e2E8E413FA8444383A83ABDbbc9F370aA269      # Founder monthly salary (~50K ZENTHIS/mo)
WALLET_AIRDROPS=0x9E47207cFD0A15a863A2a28E664bb49801d5Ad7A

# ── Etherscan API key (for contract verification) ────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
